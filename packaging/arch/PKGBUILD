# Maintainer: Gareth Palmer <gareth@one-space.co.za>
#
# Build from a checkout:  cd packaging/arch && makepkg -si
pkgname=mct-t6-dkms
pkgver=0.1.0
pkgrel=1
pkgdesc="DRM driver for MCT Trigger 6 USB display adapters and docks (DKMS)"
arch=('any')
license=('GPL-2.0-only')
depends=('dkms')
optdepends=('linux-headers: build the module for the linux kernel')
source=()

package() {
	local dest="$pkgdir/usr/src/mct-t6-$pkgver"
	local repo="$startdir/../.."

	install -Dm644 "$repo/dkms.conf" "$dest/dkms.conf"
	install -Dm644 -t "$dest/src" "$repo"/src/*.c "$repo"/src/*.h \
		"$repo/src/Kbuild"
	install -Dm644 "$repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
