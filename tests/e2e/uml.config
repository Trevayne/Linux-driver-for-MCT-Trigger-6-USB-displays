# Kernel config fragment for the mct_t6 end-to-end test kernel (ARCH=um).
# Merged on top of "make ARCH=um defconfig" by run.sh; run.sh then checks
# that every "=y"/"=m" line below survived olddefconfig.

# --- Keep the build small ---------------------------------------------------
CONFIG_DEBUG_INFO_NONE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# --- Root filesystem and test plumbing -------------------------------------
CONFIG_HOSTFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_DEBUG_FS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KUNIT=y
CONFIG_PRINTK_TIME=y
# Big enough that dmesg.txt holds the whole run (KTAP is at the start).
CONFIG_LOG_BUF_SHIFT=21
CONFIG_MAGIC_SYSRQ=y

# --- IOMEM/DMA emulation (USB and DRM need HAS_IOMEM/HAS_DMA on UML) -------
# No virtio device is attached at run time; this only provides the
# emulation layers.  UML_PCI_OVER_VFIO stays off: nothing may touch real
# hardware.
CONFIG_VIRTIO_UML=y
CONFIG_UML_PCI_OVER_VIRTIO=y
# Any ID silences the boot-time "no virtio device ID" WARN; KUnit's UML
# config uses the same value.
CONFIG_UML_PCI_OVER_VIRTIO_DEVICE_ID=1234
# CONFIG_UML_PCI_OVER_VFIO is not set

# --- USB: dummy host + dummy UDC, with raw-gadget for the emulator ---------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_RAW_GADGET=y

# --- DRM ----------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# GUD is a USB display driver that never binds here; building it in selects
# DRM_KMS_HELPER, DRM_GEM_SHMEM_HELPER and DRM_CLIENT_SELECTION as built-ins,
# so mct_t6.ko can be insmod'ed without resolving module dependencies.
CONFIG_DRM_GUD=y

# --- Bug finding ------------------------------------------------------------
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_VMALLOC=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_WQ_WATCHDOG=y
